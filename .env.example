# Execução fora do Docker (uv run): banco local do pgAdmin ou do Compose. Ajuste porta,
# usuário, senha e nome do banco. Dentro do Docker, compose.yml monta DATABASE_URL sozinho.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/ProjetoIntergrador_2

# Docker Compose (compose.yml e database/docker-compose.yml). Evite @ : / ? # na senha.
POSTGRES_DB=pi2_seguranca_publica
POSTGRES_USER=pi2
POSTGRES_PASSWORD=altere-esta-senha
DB_PORT=5433
# Interface onde o banco do Compose escuta: 127.0.0.1 (só esta máquina) ou 0.0.0.0 /
# IP da rede local para acesso de outros computadores da rede (sempre com senha).
DB_BIND=127.0.0.1
APP_PORT=8000

# Token do Cloudflare Tunnel (painel Zero Trust), exigido só pelo perfil "tunel".
# CLOUDFLARE_TUNNEL_TOKEN=

# IPs ou CIDRs, separados por vírgula, cujo cabeçalho CF-Connecting-IP é confiável.
# Vale para a execução fora do Docker (cloudflared na mesma máquina); no Compose,
# compose.yml define o IP fixo do contêiner cloudflared.
GEOHABITA_PROXIES_CONFIAVEIS=127.0.0.1,::1
